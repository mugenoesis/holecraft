{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreBinaries": ["wait"],
	"workspaces": {
		".": {
			"entry": ["e2e/**/*.spec.ts", "e2e/playwright.config.ts", "scripts/lib/*.ts"],
			"project": ["e2e/**/*.ts", "scripts/lib/*.ts"]
		},
		"packages/core": { "project": ["src/**/*.ts"] },
		"packages/geometry": { "project": ["src/**/*.ts"] },
		"apps/server": { "project": ["src/**/*.ts"] },
		"apps/web": { "entry": ["src/geometry/geometry.worker.ts"], "project": ["src/**/*.{ts,tsx}"] },
		"apps/desktop": { "project": ["src/**/*.ts"] }
	}
}
