{
	"name": "@holecraft/desktop",
	"productName": "Holecraft",
	"version": "0.5.1",
	"private": true,
	"description": "Holecraft desktop app for Linux",
	"license": "AGPL-3.0-only",
	"author": {
		"name": "Holecraft contributors",
		"email": "noreply@holecraft.invalid"
	},
	"homepage": "https://github.com/mugenoesis/holecraft",
	"desktopName": "holecraft.desktop",
	"main": "dist/main.cjs",
	"scripts": {
		"build": "node build.mjs",
		"start": "electron .",
		"dist": "electron-builder --linux AppImage deb"
	},
	"devDependencies": {
		"@holecraft/server": "0.5.1",
		"electron": "44.7.0",
		"electron-builder": "^26.18.0"
	},
	"build": {
		"appId": "org.holecraft.desktop",
		"productName": "Holecraft",
		"executableName": "holecraft",
		"artifactName": "${productName}-${version}-${arch}.${ext}",
		"directories": {
			"output": "release"
		},
		"afterPack": "dist/afterPack.cjs",
		"files": [
			"dist/**/*",
			"!dist/afterPack.cjs*",
			"package.json"
		],
		"extraResources": [
			{
				"from": "../web/dist",
				"to": "web"
			}
		],
		"linux": {
			"category": "Graphics",
			"syncDesktopName": true,
			"synopsis": "Easy offline 3D modeling for makers",
			"icon": "build/icon.png",
			"target": [
				"AppImage",
				"deb"
			]
		}
	}
}
