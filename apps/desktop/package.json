{
  "name": "@ezcad/desktop",
  "productName": "ezcad",
  "version": "0.1.0",
  "private": true,
  "description": "ezcad desktop app for Linux",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "ezcad contributors",
    "email": "noreply@ezcad.invalid"
  },
  "homepage": "https://github.com/ezcad/ezcad",
  "desktopName": "ezcad.desktop",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "electron .",
    "dist": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "@ezcad/server": "0.1.0",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.ezcad.desktop",
    "productName": "ezcad",
    "executableName": "ezcad",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "linux": {
      "category": "Graphics",
      "syncDesktopName": true,
      "synopsis": "Easy offline 3D modeling for makers",
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
