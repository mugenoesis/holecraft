#!/usr/bin/env bash
# Fast gate on every commit (replaces the CI feedback loop): Biome, unused code, typecheck, unit tests.
# The slower checks (coverage floors, build, browser tests) run in pre-push.
# Skip once with `git commit --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

step() { printf '\n\033[1m== pre-commit: %s ==\033[0m\n' "$*"; }

step "biome";     npm run --silent lint
step "knip";      npm run --silent knip
step "typecheck"; npm run --silent typecheck
step "unit tests"; npm test --silent
